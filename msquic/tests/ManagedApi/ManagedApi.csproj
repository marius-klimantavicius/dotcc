<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MsQuic.ManagedApi</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ManagedApi/*.cs" />
    <Compile Include="../TlsAdapter/Credentials.cs" />
    <ProjectReference Include="../../src/BclHost/BclHost.csproj" />
    <TrimmerRootAssembly Include="TranslatedMsQuic" />
  </ItemGroup>
</Project>
