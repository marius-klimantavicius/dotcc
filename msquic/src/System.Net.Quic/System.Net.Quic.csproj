<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Managed.System.Net.Quic</AssemblyName>
    <RootNamespace>System.Net.Quic</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);CS0436;CS3021;CS0219</NoWarn>
    <TranslatedMsQuicDirectory Condition="'$(TranslatedMsQuicDirectory)' == ''">$(MSBuildThisFileDirectory)../../generated/TranslatedMsQuic</TranslatedMsQuicDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Partials and the host must use the same compiled MsQuic types and globals. -->
    <Compile Include="$(TranslatedMsQuicDirectory)/MsQuic*.cs" Link="TranslatedMsQuic/%(Filename)%(Extension)" />
    <Compile Include="../BclHost/*.cs" Link="BclHost/%(Filename)%(Extension)" />
    <ProjectReference Include="../../../picotls/src/BclProvider/BclProvider.csproj" />
    <EmbeddedResource Update="Strings.resx" LogicalName="FxResources.System.Net.Quic.SR.resources" />
  </ItemGroup>
  <Target Name="CheckTranslatedMsQuic" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(TranslatedMsQuicDirectory)/MsQuic.cs')" Text="Generate MsQuic first using msquic/scripts/translate.sh, or set TranslatedMsQuicDirectory to the final postprocessed source directory." />
  </Target>
</Project>
