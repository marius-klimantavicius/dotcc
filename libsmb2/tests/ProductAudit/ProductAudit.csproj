<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IlcGenerateMapFile>true</IlcGenerateMapFile>
    <Libsmb2GeneratedProject Condition="'$(Libsmb2GeneratedProject)' == ''">$(MSBuildThisFileDirectory)../../generated/TranslatedLibsmb2/TranslatedLibsmb2.csproj</Libsmb2GeneratedProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Libsmb2GeneratedProject)" />
    <!-- Compile the complete generated library, including public entry points
         that this deliberately tiny executable never invokes. -->
    <TrimmerRootAssembly Include="TranslatedLibsmb2" />
  </ItemGroup>
</Project>
