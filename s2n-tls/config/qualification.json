    "scripts/upstream_qualification.py",
    "scripts/qualification.py",
    "scripts/managed-qualification.py",
    "scripts/translation_evidence.py",
    "tests/Upstream/run.py",
    "tests/Upstream/python_receipt.py",
    "tests/Upstream/feature_adaptations.py",
    "tests/Upstream/test-adaptations.json",
    "tests/Upstream/hrr_applicability.py",
    "tests/Upstream/measured_psk.py",
    "tests/Provider/required_c_receipt.py",
    "tests/Provider/native_profile.py"
  ]
}
