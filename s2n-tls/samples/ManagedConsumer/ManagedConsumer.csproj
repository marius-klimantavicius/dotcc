<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <S2nManagedProject Condition="'$(S2nManagedProject)' == ''">../../src/Managed.S2nTls/Managed.S2nTls.csproj</S2nManagedProject>
    <S2nTlsProject Condition="'$(S2nTlsProject)' == ''">../../generated/TranslatedS2nTls/TranslatedS2nTls.csproj</S2nTlsProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(S2nManagedProject)" />
  </ItemGroup>
</Project>
