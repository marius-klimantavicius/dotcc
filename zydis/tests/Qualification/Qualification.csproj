<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Zydis.Qualification</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TranslatedProject Condition="'$(TranslatedProject)' == ''">../../generated/TranslatedZydisQualification/TranslatedZydisQualification.csproj</TranslatedProject>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(TranslatedProject)" /></ItemGroup>
  <ItemGroup Condition="'$(RootQualificationLibrary)' == 'true'">
    <TrimmerRootAssembly Include="TranslatedZydisQualification" />
  </ItemGroup>
</Project>
