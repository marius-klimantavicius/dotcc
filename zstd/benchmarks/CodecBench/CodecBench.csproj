<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <ManagedZstdProject Condition="'$(ManagedZstdProject)' == ''">$(MSBuildThisFileDirectory)../../src/Managed.Zstd/Managed.Zstd.csproj</ManagedZstdProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ManagedZstdProject)" AdditionalProperties="ZstdProject=$(ZstdProject)" />
  </ItemGroup>
</Project>
