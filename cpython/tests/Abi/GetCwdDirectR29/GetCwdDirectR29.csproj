<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PosixFsSource Condition="'$(PosixFsSource)' == ''">$(MSBuildThisFileDirectory)../../../../DotCC.Libc/PosixFsLib.cs</PosixFsSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../../DotCC.Libc/*.cs" Exclude="../../../../DotCC.Libc/PosixFsLib.cs" />
    <Compile Include="$(PosixFsSource)" />
  </ItemGroup>
</Project>
