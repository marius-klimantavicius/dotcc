<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup><Reference Include="TranslatedCPython"><HintPath>$(CPythonAssembly)</HintPath></Reference></ItemGroup>
  <Target Name="RequireActualProduct" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(CPythonAssembly)')" Text="Supply the exact regenerated TranslatedCPython Release PE." />
  </Target>
</Project>
