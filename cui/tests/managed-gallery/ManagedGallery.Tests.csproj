<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GalleryProject Condition="'$(GalleryProject)' == '' and '$(CuiVariant)' == 'Raw'">../../generated/TranslatedCuiGallery.Raw/TranslatedCuiGallery.csproj</GalleryProject>
    <GalleryProject Condition="'$(GalleryProject)' == ''">../../generated/TranslatedCuiGallery/TranslatedCuiGallery.csproj</GalleryProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../desktop/OsInput.cs" Link="OsInput.cs" />
    <Compile Include="../gallery/Observation.cs" Link="Observation.cs" />
    <Compile Include="../gallery/ClockFixture.cs" Link="ClockFixture.cs" />
    <Compile Include="../gallery/ExtendedInteractions.cs" Link="ExtendedInteractions.cs" />
    <Compile Include="../gallery/ResponsiveInteractions.cs" Link="ResponsiveInteractions.cs" />
    <ProjectReference Include="../../samples/ManagedGallery/ManagedGallery.csproj" />
    <ProjectReference Include="$(GalleryProject)" />
  </ItemGroup>
</Project>
