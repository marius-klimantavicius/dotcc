<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <CuiProject Condition="'$(CuiProject)' == ''">../../generated/TranslatedCui/TranslatedCui.csproj</CuiProject>
    <GalleryProject Condition="'$(GalleryProject)' == ''">../../generated/TranslatedCuiGallery/TranslatedCuiGallery.csproj</GalleryProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../desktop/OsInput.cs" Link="OsInput.cs" />
    <ProjectReference Include="$(CuiProject)" />
    <ProjectReference Include="$(GalleryProject)" />
    <ProjectReference Include="../../src/Glfw/Glfw.csproj" />
  </ItemGroup>
</Project>
