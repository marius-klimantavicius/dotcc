<Project>
  <!-- Import in an ordinary executable consumer, never in the API or worker.
       The worker references the API; this non-reference build edge is acyclic. -->
  <PropertyGroup>
    <BlinkWorkerProject Condition="'$(BlinkWorkerProject)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../Managed.Emulation.Worker/Managed.Emulation.Worker.csproj'))</BlinkWorkerProject>
    <BlinkDeployWorker Condition="'$(BlinkDeployWorker)' == ''">true</BlinkDeployWorker>
  </PropertyGroup>
  <ItemGroup Condition="'$(BlinkDeployWorker)' == 'true'">
    <ProjectReference Include="$(BlinkWorkerProject)" ReferenceOutputAssembly="false" Private="false"
      GlobalPropertiesToRemove="PublishDir;OutputPath;OutDir" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="TranslatedBlink" />
  </ItemGroup>

  <Target Name="BlinkCopyWorkerBuild" AfterTargets="Build"
          Condition="'$(BlinkDeployWorker)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(BlinkWorkerProject)" Targets="BlinkGetWorkerBuildFiles"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             RemoveProperties="PublishDir;OutputPath;OutDir">
      <Output TaskParameter="TargetOutputs" ItemName="_BlinkWorkerBuildFile" />
    </MSBuild>
    <Error Condition="'@(_BlinkWorkerBuildFile)' == ''" Text="The worker build returned no deployment files." />
    <Error Condition="'%(_BlinkWorkerBuildFile.WorkerRelativePath)' == ''" Text="A worker deployment file has no relative output path: %(_BlinkWorkerBuildFile.Identity)" />
    <RemoveDir Directories="$(TargetDir)blink-worker" />
    <Copy SourceFiles="@(_BlinkWorkerBuildFile)"
          DestinationFiles="@(_BlinkWorkerBuildFile->'$(TargetDir)blink-worker/%(WorkerRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BlinkPublishWorker" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(BlinkDeployWorker)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' == ''"
           Text="Publishing an AOT consumer with its matching worker requires an explicit RuntimeIdentifier." />
    <PropertyGroup>
      <_BlinkWorkerArtifacts>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'blink-worker-artifacts'))</_BlinkWorkerArtifacts>
      <_BlinkWorkerPublish>$([MSBuild]::NormalizeDirectory('$(_BlinkWorkerArtifacts)', 'publish-closure'))</_BlinkWorkerPublish>
      <_BlinkWorkerProperties>Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);PublishAot=$(PublishAot);SelfContained=$(SelfContained);UseArtifactsOutput=true;ArtifactsPath=$(_BlinkWorkerArtifacts);PublishDir=$(_BlinkWorkerPublish);BlinkDeployWorker=false</_BlinkWorkerProperties>
    </PropertyGroup>
    <RemoveDir Directories="$(_BlinkWorkerPublish)" />
    <MSBuild Projects="$(BlinkWorkerProject)" Targets="Restore"
             Properties="$(_BlinkWorkerProperties)" RemoveProperties="OutputPath;OutDir;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <!-- Restore creates package imports in this isolated artifacts directory.
         A different global-property set forces evaluation after those imports
         exist, so a first publish loads the NativeAOT targets as well. -->
    <MSBuild Projects="$(BlinkWorkerProject)" Targets="Publish"
             Properties="$(_BlinkWorkerProperties);BlinkWorkerPublishAfterRestore=true" RemoveProperties="OutputPath;OutDir;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <Error Condition="'$(PublishAot)' == 'true' and !Exists('$(_BlinkWorkerPublish)Managed.Emulation.Worker') and !Exists('$(_BlinkWorkerPublish)Managed.Emulation.Worker.exe')"
           Text="The matching NativeAOT worker publish did not produce its native executable." />
    <ItemGroup>
      <_BlinkWorkerPublished Include="$(_BlinkWorkerPublish)**/*" />
      <ResolvedFileToPublish Include="@(_BlinkWorkerPublished)">
        <RelativePath>blink-worker/$([System.IO.Path]::GetRelativePath('$(_BlinkWorkerPublish)', '%(_BlinkWorkerPublished.FullPath)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
