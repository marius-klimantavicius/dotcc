    <_BlinkFullCoreSource Include="Sources/BlinkCore.00010.cs" ExpectedSha256="9c56ff2693dc2e09c322d23fb4fe20069a0bea47b6e724b7d484d1bae51bad84" />
    <_BlinkFullCoreSource Include="Sources/BlinkCore.00011.cs" ExpectedSha256="0275c370a3c1d36bee738d105714180d47879d83de3211567fa622acc0809f36" />
