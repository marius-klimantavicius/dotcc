<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <BlinkProject Condition="'$(BlinkProject)' == ''">$(MSBuildThisFileDirectory)../../generated/TranslatedBlink/TranslatedBlink.csproj</BlinkProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(BlinkProject)" />
  </ItemGroup>
</Project>
