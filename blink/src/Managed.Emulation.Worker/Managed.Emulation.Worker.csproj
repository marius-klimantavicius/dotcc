<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Managed.Emulation/Managed.Emulation.csproj" />
    <ProjectReference Include="../Managed.Emulation.ThreadedExecution/Managed.Emulation.ThreadedExecution.csproj" />
    <TrimmerRootAssembly Include="TranslatedBlink" />
  </ItemGroup>
  <Target Name="BlinkGetWorkerBuildFiles" Returns="@(_BlinkWorkerClosure)">
    <ItemGroup>
      <_BlinkWorkerClosure Include="$(TargetDir)**/*"
                          Exclude="$(TargetDir)publish/**/*;$(TargetDir)blink-worker/**/*;$(TargetDir)**/*.cs">
        <WorkerRelativePath>%(RecursiveDir)%(Filename)%(Extension)</WorkerRelativePath>
      </_BlinkWorkerClosure>
    </ItemGroup>
  </Target>
</Project>
