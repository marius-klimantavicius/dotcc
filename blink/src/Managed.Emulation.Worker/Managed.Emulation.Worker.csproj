<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Managed.Emulation/Managed.Emulation.csproj" />
    <ProjectReference Include="../Managed.Emulation.ThreadedExecution/Managed.Emulation.ThreadedExecution.csproj" />
    <TrimmerRootAssembly Include="TranslatedBlink" />
  </ItemGroup>
  <Target Name="BlinkGetWorkerBuildFiles" DependsOnTargets="Build" Returns="@(_BlinkWorkerClosure)">
    <!-- Use this build's output inventory, never a recursive bin glob: bin can
         also contain old RID, publish, or other configuration closures. -->
    <FindUnderPath Path="$(TargetDir)" Files="@(FileWrites);@(FileWritesShareable)">
      <Output TaskParameter="InPath" ItemName="_BlinkWorkerOutput" />
    </FindUnderPath>
    <RemoveDuplicates Inputs="@(_BlinkWorkerOutput->'%(FullPath)')">
      <Output TaskParameter="Filtered" ItemName="_BlinkWorkerClosure" />
    </RemoveDuplicates>
    <ItemGroup>
      <_BlinkWorkerClosure>
        <WorkerRelativePath>$([System.IO.Path]::GetRelativePath('$(TargetDir)', '%(_BlinkWorkerClosure.FullPath)'))</WorkerRelativePath>
      </_BlinkWorkerClosure>
    </ItemGroup>
  </Target>
</Project>
