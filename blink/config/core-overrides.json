{
  "version": 1,
  "macroOverrides": [
    {
      "name": "dontinline",
      "match": { "exact": "__attribute__((__noinline__))" },
      "replacement": "",
      "requireMatch": false
    },
    {
      "name": "pureconst",
      "match": { "exact": "__attribute__((__const__))" },
      "replacement": "",
      "requireMatch": true
    },
    {
      "name": "flattencalls",
      "match": { "exact": "__attribute__((__flatten__))" },
      "replacement": "",
      "requireMatch": true
    }
  ]
}
