<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsAotCompatible>true</IsAotCompatible>
    <BenchLibrary Condition="'$(BenchLibrary)' == ''">lib</BenchLibrary>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Managed.Emulation.Host"><HintPath>$(BenchLibrary)/Managed.Emulation.Host.dll</HintPath></Reference>
    <Reference Include="Managed.Emulation.ThreadedExecution"><HintPath>$(BenchLibrary)/Managed.Emulation.ThreadedExecution.dll</HintPath></Reference>
    <Reference Include="TranslatedBlink"><HintPath>$(BenchLibrary)/TranslatedBlink.dll</HintPath></Reference>
  </ItemGroup>
</Project>
