<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsAotCompatible>true</IsAotCompatible>
    <BlinkProject Condition="'$(BlinkProject)' == ''">../../../generated/TranslatedBlink/TranslatedBlink.csproj</BlinkProject>
    <ContractsSource Condition="'$(ContractsSource)' == ''">../../../src/Managed.Emulation.ThreadedExecution/Jit/JitContracts.cs</ContractsSource>
    <EmitterSource Condition="'$(EmitterSource)' == ''">../../../src/Managed.Emulation.ThreadedExecution/Jit/X64BlockEmitter.cs</EmitterSource>
    <DefineConstants Condition="'$(LegacyEmitter)' == 'true'">$(DefineConstants);LEGACY_EMITTER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(BlinkProject)" />
    <Compile Include="$(ContractsSource)" Link="JitContracts.cs" />
    <Compile Include="$(EmitterSource)" Link="X64BlockEmitter.cs" />
  </ItemGroup>
</Project>
