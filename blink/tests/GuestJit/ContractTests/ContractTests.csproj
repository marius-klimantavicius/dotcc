<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <Import Project="../../../src/Managed.Emulation.ThreadedExecution/Managed.Emulation.ThreadedExecution.props" />
  <ItemGroup>
    <ProjectReference Include="$(BlinkProject)" />
    <!-- Compile the exact authored controller into this assembly so test-only
         partial fixtures can inspect its precision/lifetime boundaries. -->
    <Compile Include="../../../src/Managed.Emulation.ThreadedExecution/**/*.cs"
             Exclude="../../../src/Managed.Emulation.ThreadedExecution/**/obj/**;../../../src/Managed.Emulation.ThreadedExecution/**/bin/**"
             Link="Execution/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
