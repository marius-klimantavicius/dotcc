<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- Link the actual implementation to exercise its internal listener as a
       native-guest oracle without adding a public host-endpoint API. -->
  <ItemGroup><Compile Include="../../src/Managed.Emulation.Host/*.cs" Link="Host/%(Filename)%(Extension)" /></ItemGroup>
</Project>
