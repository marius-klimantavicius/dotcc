<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CoreClrService</AssemblyName>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <RollForward>Disable</RollForward>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <PublishReadyToRunCrossgen2ExtraArgs>--parallelism:2</PublishReadyToRunCrossgen2ExtraArgs>
    <Deterministic>true</Deterministic>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="global.json" CopyToPublishDirectory="Never" />
    <FrameworkReference Update="Microsoft.AspNetCore.App" RuntimeFrameworkVersion="10.0.12" />
    <KnownCrossgen2Pack Update="Microsoft.NETCore.App.Crossgen2" Crossgen2PackVersion="10.0.12" />
    <KnownFrameworkReference Update="Microsoft.NETCore.App" TargetingPackVersion="10.0.12" />
    <KnownFrameworkReference Update="Microsoft.AspNetCore.App" TargetingPackVersion="10.0.12" />
  </ItemGroup>
  <Target Name="RecordReadyToRunTools" AfterTargets="ResolveReadyToRunCompilers">
    <WriteLinesToFile File="$(IntermediateOutputPath)readytorun-tools.txt"
      Lines="@(Crossgen2Tool->'compiler=%(Identity)');@(ResolvedCrossgen2Pack->'compiler-package=%(PackageDirectory)|%(NuGetPackageVersion)');@(ResolvedRuntimePack->'runtime-pack=%(PackageDirectory)|%(NuGetPackageVersion)');@(ResolvedTargetingPack->'targeting-pack=%(Path)|%(NuGetPackageVersion)')"
      Overwrite="true" />
  </Target>
</Project>
