<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TranslatedProject Condition="'$(TranslatedProject)' == ''">../../generated/TranslatedLibuv/TranslatedLibuv.csproj</TranslatedProject>
  </PropertyGroup>
  <Target Name="RequireTranslatedLibuv" BeforeTargets="Build">
    <Error Condition="!Exists('$(TranslatedProject)')" Text="The all-platform TranslatedLibuv product is not yet published. Diagnostic source probes are not a usable libuv implementation." />
  </Target>
  <ItemGroup Condition="Exists('$(TranslatedProject)')">
    <ProjectReference Include="$(TranslatedProject)" />
  </ItemGroup>
</Project>
