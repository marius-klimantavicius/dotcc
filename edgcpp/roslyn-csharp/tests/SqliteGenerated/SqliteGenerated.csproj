<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InventoryReport Condition="'$(InventoryReport)' == ''">/mnt/storage/roslynobj-csharp-20261015/t0/sqlite-inventory-address-closure/program-report.json</InventoryReport>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(SqliteApiAliases)" />
    <ProjectReference Include="$(GeneratedProject)" />
  </ItemGroup>
  <Target Name="ValidateCapturedSqliteApi" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GeneratedProject)') Or !Exists('$(CandidateReceipt)') Or !Exists('$(SqliteApiAliases)') Or !Exists('$(SqliteApiReceipt)')" Text="Provide an unpublished zero-error candidate, matching CandidateReceipt, and aliases/receipt produced by SurfaceValidator.py." />
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)SurfaceValidator.py&quot; --generated-project &quot;$(GeneratedProject)&quot; --candidate-receipt &quot;$(CandidateReceipt)&quot; --inventory &quot;$(InventoryReport)&quot; --aliases &quot;$(SqliteApiAliases)&quot; --report &quot;$(SqliteApiReceipt)&quot; --verify-only" />
  </Target>
</Project>
