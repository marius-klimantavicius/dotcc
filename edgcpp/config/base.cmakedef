# Local broad-feature profile; upstream revision is pinned by build.sh.
import <linux-gcc-release/base>

# Compile in dialects and optional language facilities; select modes per input.
ATT_PREPROCESSING_EXTENSIONS_ALLOWED=1
SUN_EXTENSIONS_ALLOWED=1
SUN_TARGET_VERSION_NUMBER=0x5120
DEFAULT_SUN_COMPATIBILITY=0
GNU_EXTENSIONS_ALLOWED=1
GNU_X86_ASM_EXTENSIONS_ALLOWED=1
MICROSOFT_EXTENSIONS_ALLOWED=1
UPC_EXTENSIONS_ALLOWED=1
CPPCLI_ENABLING_POSSIBLE=1
CPPCX_ENABLING_POSSIBLE=1
REFLECTION_ENABLING_POSSIBLE=1
COROUTINE_ENABLING_POSSIBLE=1
EXPORT_ENABLING_POSSIBLE=1
INT128_EXTENSIONS_ALLOWED=1
FLOAT80_ENABLING_POSSIBLE=1
FLOAT128_ENABLING_POSSIBLE=1
GNU_VECTOR_TYPES_ALLOWED=1
GNU_NAKED_ATTRIBUTE_ALLOWED=1
GNU_X86_ATTRIBUTES_ALLOWED=1
ASM_FUNCTION_ALLOWED=1
PRAGMA_WEAK_ALLOWED=1
PTR_TO_INCOMP_ARRAY_ARITHMETIC_ALLOWED=1
C_ANACHRONISMS_ALLOWED=1
ADDR_OF_BIT_FIELD_ALLOWED=1
NEAR_AND_FAR_ALLOWED=1
EMBEDDED_C_ALLOWED=1
FIXED_POINT_ALLOWED=1
NAMED_ADDRESS_SPACES_ALLOWED=1
NAMED_REGISTERS_ALLOWED=1
VLA_ALLOWED=1
COMPOUND_LITERAL_ENABLING_POSSIBLE=1
BOOL_ENABLING_POSSIBLE=1
WCHAR_T_ENABLING_POSSIBLE=1
EXC_SPEC_IN_FUNC_TYPE_ENABLING_POSSIBLE=1
RTTI_ENABLING_POSSIBLE=1
ARRAY_NEW_AND_DELETE_ENABLING_POSSIBLE=1
THREAD_LOCAL_STORAGE_SPECIFIER_ALLOWED=1

# Retain IL inspection/serialization for backend investigation.
IL_SHOULD_BE_WRITTEN_TO_FILE=1
NEED_IL_DISPLAY=1
