{
  "query": "select t.value,s.id,k.name,r.is_defined,r.body_root_id,r.body_scope_id,s.type_id from text_atom t join source_correspondence c on c.current_name_id=t.id join entity_source_correspondence x on x.source_correspondence_id=c.id join symbol s on s.id=x.owner_id join kind k on k.id=s.kind_id left join routine_symbol r on r.id=s.id where t.value in (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) order by t.value,s.id",
