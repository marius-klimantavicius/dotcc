/* Portable libc++18 external thread ABI for translated C#.
   Native pthread/Windows handles never appear in this interface. */
#ifndef __EDG_DOT_LIBCXX_EXTERNAL_THREADING
#define __EDG_DOT_LIBCXX_EXTERNAL_THREADING
#include <__config>
#include <__chrono/duration.h>
#include <time.h>

typedef ::timespec __libcpp_timespec_t;
#define _LIBCPP_MUTEX_INITIALIZER 0UL
#define _LIBCPP_CONDVAR_INITIALIZER 0UL
#define _LIBCPP_EXEC_ONCE_INITIALIZER 0UL
#define _LIBCPP_NULL_THREAD 0UL
#define _LIBCPP_TLS_DESTRUCTOR_CC

#include <__edg_thread_abi.h>

_LIBCPP_BEGIN_NAMESPACE_STD
// Storage is a zero-initialized token in the translated owner's ordinary
// object/global arena. The provider creates the BCL resource on first use.
typedef unsigned long __libcpp_mutex_t;
typedef unsigned long __libcpp_recursive_mutex_t;
typedef unsigned long __libcpp_condvar_t;
typedef unsigned long __libcpp_exec_once_flag;
typedef unsigned long __libcpp_thread_id;
typedef unsigned long __libcpp_thread_t;
typedef unsigned long __libcpp_tls_key;

inline _LIBCPP_HIDE_FROM_ABI int __libcpp_recursive_mutex_init(__libcpp_recursive_mutex_t* m) {
  *m = 0; return __edg_libcpp_recursive_mutex_init(m);
}
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_recursive_mutex_lock(__libcpp_recursive_mutex_t* m) { return __edg_libcpp_mutex_lock(m, 1); }
inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_recursive_mutex_trylock(__libcpp_recursive_mutex_t* m) { return __edg_libcpp_mutex_trylock(m, 1) != 0; }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_recursive_mutex_unlock(__libcpp_recursive_mutex_t* m) { return __edg_libcpp_mutex_unlock(m, 1); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_recursive_mutex_destroy(__libcpp_recursive_mutex_t* m) { return __edg_libcpp_mutex_destroy(m, 1); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_mutex_lock(__libcpp_mutex_t* m) { return __edg_libcpp_mutex_lock(m, 0); }
inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_mutex_trylock(__libcpp_mutex_t* m) { return __edg_libcpp_mutex_trylock(m, 0) != 0; }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_mutex_unlock(__libcpp_mutex_t* m) { return __edg_libcpp_mutex_unlock(m, 0); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_mutex_destroy(__libcpp_mutex_t* m) { return __edg_libcpp_mutex_destroy(m, 0); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_condvar_signal(__libcpp_condvar_t* cv) { return __edg_libcpp_condvar_signal(cv, 0); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_condvar_broadcast(__libcpp_condvar_t* cv) { return __edg_libcpp_condvar_signal(cv, 1); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_condvar_wait(__libcpp_condvar_t* cv, __libcpp_mutex_t* m) { return __edg_libcpp_condvar_wait(cv, m, nullptr); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_condvar_timedwait(__libcpp_condvar_t* cv, __libcpp_mutex_t* m, __libcpp_timespec_t* ts) { return __edg_libcpp_condvar_wait(cv, m, ts); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_condvar_destroy(__libcpp_condvar_t* cv) { return __edg_libcpp_condvar_destroy(cv); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_execute_once(__libcpp_exec_once_flag* flag, void (*function)()) { return __edg_libcpp_execute_once(flag, function); }
inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_thread_id_equal(__libcpp_thread_id a, __libcpp_thread_id b) { return a == b; }
inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_thread_id_less(__libcpp_thread_id a, __libcpp_thread_id b) { return a < b; }
inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_thread_isnull(const __libcpp_thread_t* t) { return *t == 0; }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_thread_create(__libcpp_thread_t* t, void* (*function)(void*), void* argument) { return __edg_libcpp_thread_create(t, function, argument); }
inline _LIBCPP_HIDE_FROM_ABI __libcpp_thread_id __libcpp_thread_get_current_id() { return __edg_libcpp_thread_current_id(); }
inline _LIBCPP_HIDE_FROM_ABI __libcpp_thread_id __libcpp_thread_get_id(const __libcpp_thread_t* t) { return __edg_libcpp_thread_get_id(t); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_thread_join(__libcpp_thread_t* t) { return __edg_libcpp_thread_join(t); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_thread_detach(__libcpp_thread_t* t) { return __edg_libcpp_thread_detach(t); }
inline _LIBCPP_HIDE_FROM_ABI void __libcpp_thread_yield() { __edg_libcpp_thread_yield(); }
inline _LIBCPP_HIDE_FROM_ABI void __libcpp_thread_sleep_for(const chrono::nanoseconds& ns) { __edg_libcpp_thread_sleep_for(ns.count()); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_tls_create(__libcpp_tls_key* key, void (*destructor)(void*)) { return __edg_libcpp_tls_create(key, destructor); }
inline _LIBCPP_HIDE_FROM_ABI void* __libcpp_tls_get(__libcpp_tls_key key) { return __edg_libcpp_tls_get(key); }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_tls_set(__libcpp_tls_key key, void* value) { return __edg_libcpp_tls_set(key, value); }
_LIBCPP_END_NAMESPACE_STD
#endif
