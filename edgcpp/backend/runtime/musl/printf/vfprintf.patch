-	olderr = f->flags & F_ERR;
-	f->flags &= ~F_ERR;
-	if (!f->buf_size) {
-		saved_buf = f->buf;
-		f->buf = internal_buf;
-		f->buf_size = sizeof internal_buf;
-		f->wpos = f->wbase = f->wend = 0;
-	}
-	if (!f->wend && __towrite(f)) ret = -1;
-	else ret = printf_core(f, fmt, &ap2, nl_arg, nl_type);
