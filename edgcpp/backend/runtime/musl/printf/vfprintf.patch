+int __edg_musl_vformat(struct edg_format_sink *f, const char *fmt, va_list arguments)
+{
+    va_list cursor;
+    int types[EDG_NL_ARGMAX+1] = {0};
+    union arg values[EDG_NL_ARGMAX+1];
+    va_copy(cursor, arguments);
+    if (printf_core(0, fmt, &cursor, values, types) < 0) {
+        va_end(cursor);
+        return -1;
+    }
+    int result = printf_core(f, fmt, &cursor, values, types);
+    va_end(cursor);
+    return edg_sink_error(f) ? -1 : result;
+}
