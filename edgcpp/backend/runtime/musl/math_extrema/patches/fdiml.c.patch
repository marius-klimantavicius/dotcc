--- a/fdiml.c
+++ b/fdiml.c
@@ -1,4 +1,5 @@
 #include <math.h>
+#include <errno.h>
 #include <float.h>
 
 #if LDBL_MANT_DIG == 53 && LDBL_MAX_EXP == 1024
@@ -13,6 +14,9 @@
 		return x;
 	if (isnan(y))
 		return y;
