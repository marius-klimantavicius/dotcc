--- a/fdimf.c
+++ b/fdimf.c
@@ -1,4 +1,5 @@
 #include <math.h>
+#include <errno.h>
 
 float fdimf(float x, float y)
 {
@@ -6,5 +7,8 @@
 		return x;
 	if (isnan(y))
 		return y;
-	return x > y ? x - y : 0;
+	float result = x > y ? x - y : 0;
+	/* Portable MATH_ERRNO profile: finite subtraction overflow. */
+	if (isinf(result) && isfinite(x) && isfinite(y)) errno = ERANGE;
+	return result;
 }
