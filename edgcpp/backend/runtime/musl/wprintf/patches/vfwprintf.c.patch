+struct edg_wformat_context {
+ struct edg_wformat_sink *sink;
+ union arg *arguments;
+ int *types;
+};
+static int edg_wformat_body(void *context, const wchar_t *format, va_list arguments)
+{
+ struct edg_wformat_context *state = (struct edg_wformat_context *)context;
+ /* A local va_copy keeps both native array-va_list and EDG's typed cursor ABI. */
+ va_list copy; va_copy(copy, arguments);
+ int result = wprintf_core(state->sink, format, &copy, state->arguments, state->types);
+ va_end(copy);
+ return edg_wformat_error(state->sink) ? -1 : result;
+}
+int __edg_musl_vwformat(struct edg_wformat_sink *sink, FILE *file, const wchar_t *format, va_list arguments)
+{
+ va_list copy;
+ int types[EDG_WFORMAT_NL_ARGMAX+1] = {0};
+ union arg values[EDG_WFORMAT_NL_ARGMAX+1];
+ va_copy(copy, arguments);
+ if (wprintf_core(0, format, &copy, values, types) < 0) { va_end(copy); return -1; }
+ struct edg_wformat_context context = { sink, values, types };
+ int result = file ? __edg_with_file_wide_lock(file, edg_wformat_body, &context, format, copy)
+                   : edg_wformat_body(&context, format, copy);
+ va_end(copy);
+ return result;
+}
