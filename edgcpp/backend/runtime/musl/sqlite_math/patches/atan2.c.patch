+/* Authored portable MATH_ERRNO boundary; the numerical algorithm is retained above. */
+#include <errno.h>
+double atan2(double x, double y)
+{
+ int saved=errno;
+ int error=0;
+ double result=__edg_musl_atan2(x,y);
+ if (!error && isfinite(x) && isfinite(y) && (isinf(result) || (result==0 && x!=0))) error=ERANGE;
+ errno=error?error:saved;
+ return result;
+}
