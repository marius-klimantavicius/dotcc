  "coverage": [
    "Actual enum types retained in globals, TLS, locals, fields, bitfields, pointers, arrays, callback signatures and public APIs.",
    "C implicit enum/integer assignment, return and call conversions; different-enum assignment; consumed pre/post increments; side-effecting conditional and bitfield expressions.",
    "Pointer/enum arithmetic retains element stride; C integer promotions and varargs remain physical integers.",
    "Signed negative unknown enum literals/cases; C++ scoped enums including unsigned 64-bit high value."
  ],
  "limits": [
    "CLR enum bases stop at64bits; extension enums wider than64bits retain physical Int128/UInt128 storage and named static constant containers.",
    "Fixed configured EDG target ABI remains unchanged; this verifies generated C# representation and conversion fidelity.",
    "No whole-language completion claim; project acceptance recorded separately."
  ]
