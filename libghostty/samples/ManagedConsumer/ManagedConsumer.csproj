<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GhosttyVt.Consumer</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The conventional product is the direct Zig -> C# engine. -->
    <TranslatedProject Condition="'$(TranslatedProject)' == ''">$(MSBuildThisFileDirectory)../../generated/TranslatedGhosttyVt/TranslatedGhosttyVt.csproj</TranslatedProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Managed.GhosttyVt/Managed.GhosttyVt.csproj" />
  </ItemGroup>
</Project>
