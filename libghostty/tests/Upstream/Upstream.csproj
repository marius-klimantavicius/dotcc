<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GhosttyVt.Upstream</AssemblyName>
    <DefineConstants Condition="'$(CoreFixtureIo)' == 'true'">$(DefineConstants);GHOSTTY_CORE_FIXTURE_IO</DefineConstants>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UpstreamProject Condition="'$(UpstreamProject)' == ''">../../generated/profiles/upstream-render/TranslatedGhosttyVt/TranslatedGhosttyVt.csproj</UpstreamProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(UpstreamProject)" />
    <TrimmerRootAssembly Include="TranslatedGhosttyVt" Condition="'$(PublishAot)' == 'true'" />
  </ItemGroup>
</Project>
