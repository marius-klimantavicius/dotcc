<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Direct Zig -> C# is the default; an explicit override can select the C fallback. -->
    <TranslatedProject Condition="'$(TranslatedProject)' == ''">$(MSBuildThisFileDirectory)../../generated/TranslatedGhosttyVt/TranslatedGhosttyVt.csproj</TranslatedProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(TranslatedProject)" />
  </ItemGroup>
</Project>
