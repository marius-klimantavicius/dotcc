<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>disable</ImplicitUsings>
    <PicotlsProject Condition="'$(PicotlsProject)' == ''">$(MSBuildThisFileDirectory)../../generated/TranslatedPicotls/TranslatedPicotls.csproj</PicotlsProject>
    <PicotlsSourceDirectory>$([System.IO.Path]::GetDirectoryName('$(PicotlsProject)'))</PicotlsSourceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the real emitted sources in the consumer assembly, without its project. -->
    <Compile Include="$(PicotlsSourceDirectory)/*.cs" Link="Translation/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
