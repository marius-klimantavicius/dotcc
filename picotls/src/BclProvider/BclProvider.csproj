<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Managed.Security</RootNamespace>
    <PicotlsProject Condition="'$(PicotlsProject)' == ''">../../generated/TranslatedPicotls/TranslatedPicotls.csproj</PicotlsProject>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MsQuic.BclHost" />
    <InternalsVisibleTo Include="TlsAdapter" />
    <InternalsVisibleTo Include="ProviderVectors" />
    <InternalsVisibleTo Include="InjectedHost" />
    <InternalsVisibleTo Include="Managed.Net.Quic" />
    <InternalsVisibleTo Include="ManagedConsumer" />
    <ProjectReference Include="$(PicotlsProject)" />
  </ItemGroup>
</Project>
