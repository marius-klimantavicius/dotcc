    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <Compile Include="../DotCC.PostProcess/ConditionRewriter.cs" Link="Rewriting/ConditionRewriter.cs" />
    <Compile Include="../DotCC.PostProcess/BooleanComparisonRewriter.cs" Link="Rewriting/BooleanComparisonRewriter.cs" />
    <Compile Include="../DotCC.PostProcess/EmptyBlockRewriter.cs" Link="Rewriting/EmptyBlockRewriter.cs" />
    <Compile Include="../DotCC.PostProcess/SourceObservability.cs" Link="Rewriting/SourceObservability.cs" />
    <InternalsVisibleTo Include="DotCC.PostProcess.CodeFixes" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
