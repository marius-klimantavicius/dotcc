<Project>
    <!-- Product-specific managed OS services, compiled beside dotcc's unchanged
         generated source. Translated C corpora share the authored memory VFS; native oracles use C. -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'TranslatedSqlite'">
        <Compile Include="$(MSBuildThisFileDirectory)src/HostVfs*.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)src/Sqlite*.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)src/MemoryVfs.cs" />
    </ItemGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TranslatedSqlite'">
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Test-'))">
        <DefineConstants>$(DefineConstants);DOTCC_SQLITE_CORPUS</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Test-'))">
        <Compile Include="$(MSBuildThisFileDirectory)src/MemoryVfs.cs" />
    </ItemGroup>
</Project>
