<Project>
    <!-- Product-specific managed OS services, compiled beside dotcc's unchanged
         generated source. Native and deterministic C corpora keep their own VFS. -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'TranslatedSqlite'">
        <Compile Include="$(MSBuildThisFileDirectory)src/HostVfs*.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)src/Sqlite*.cs" />
    </ItemGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TranslatedSqlite'">
        <Nullable>enable</Nullable>
    </PropertyGroup>
</Project>
