{
  "version": 1,
  "macroOverrides": [
    {
      "name": "SQLITE_BIGENDIAN",
      "match": {
        "exact": "(*(char *)(&sqlite3one)==0)"
      },
      "replacement": "(!__dotcc_is_little_endian())",
      "requireMatch": true
    },
    {
      "name": "SQLITE_LITTLEENDIAN",
      "match": {
        "exact": "(*(char *)(&sqlite3one)==1)"
      },
      "replacement": "(__dotcc_is_little_endian())",
      "requireMatch": true
    }
  ],
  "functionOverrides": [
    {
      "name": "sqlite3_os_init",
      "signature": {
        "returnType": "int",
        "parameterTypes": []
      },
      "target": {
        "kind": "managedMethod",
        "method": "global::Managed.Database.HostVfs.RegisterVfs"
      },
      "requireMatch": true
    },
    {
      "name": "sqlite3_os_end",
      "signature": {
        "returnType": "int",
        "parameterTypes": []
      },
      "target": {
        "kind": "managedMethod",
        "method": "global::Managed.Database.HostVfs.UnregisterVfs"
      },
      "requireMatch": true
    },
    {
      "name": "sqlite3DefaultMutex",
      "signature": {
        "returnType": "const sqlite3_mutex_methods *",
        "parameterTypes": []
      },
      "target": {
        "kind": "managedMethod",
        "method": "global::Managed.Database.HostMutex.GetMutextMethods"
      },
      "requireMatch": true
    },
    {
      "name": "sqlite3MemoryBarrier",
      "signature": {
        "returnType": "void",
        "parameterTypes": []
      },
      "target": {
        "kind": "managedMethod",
        "method": "global::System.Threading.Thread.MemoryBarrier"
      },
      "requireMatch": true
    }
  ]
}
