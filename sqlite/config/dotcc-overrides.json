{
  "version": 1,
  "macroOverrides": [
    {
      "name": "SQLITE_BIGENDIAN",
      "match": { "exact": "(*(char *)(&sqlite3one)==0)" },
      "replacement": "(!__dotcc_is_little_endian())",
      "requireMatch": true
    },
    {
      "name": "SQLITE_LITTLEENDIAN",
      "match": { "exact": "(*(char *)(&sqlite3one)==1)" },
      "replacement": "(__dotcc_is_little_endian())",
      "requireMatch": true
    }
  ]
}
