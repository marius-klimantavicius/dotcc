<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <TranslatedProject Condition="'$(TranslatedProject)' == ''">$(MSBuildThisFileDirectory)../../generated/TranslatedPGlite/TranslatedPGlite.csproj</TranslatedProject>
    <InitdbTranslatedProject Condition="'$(InitdbTranslatedProject)' == ''">$(MSBuildThisFileDirectory)../../generated/TranslatedInitdb/TranslatedInitdb.csproj</InitdbTranslatedProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Api/PGlite.csproj" />
    <Compile Include="../../tests/Product/SqlCases.cs" Link="SqlCases.cs" />
    <Content Include="../../tests/native/cases.json" Link="cases.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireTranslatedPGlite" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TranslatedProject)')"
           Text="Translated PGlite is unavailable. Run the PGlite translation campaign and resolve its complete-core embedding gates before building this consumer. A native PostgreSQL control cannot provide this product." />
  </Target>
  <Import Project="NativeAotNotices.targets" />
</Project>
